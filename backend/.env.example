# Server
PORT=5000
NODE_ENV=development

# MongoDB (optional - app works with local JSON DB if not provided)
MONGO_URI=mongodb://localhost:27017/plantrix

# Plant Identification API (Pl@ntNet - free tier available)
# Get your key here: https://my.plantnet.org/
PLANTNET_API_KEY=your_plantnet_api_key_here

# Plant.id API (alternative identification + disease detection provider)
# Get your key here: https://web.plant.id/
PLANT_ID_API_KEY=your_plant_id_api_key_here

# OpenWeatherMap API (for weather-suitability check)
# Get your key here: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here

# JWT (for future auth of "My Garden" saved plants)
JWT_SECRET=change_this_to_a_long_random_string
